# Frontend API endpoint. Leave empty when Vite proxies the same origin.
VITE_API_URL=

# Browser SpeechRecognition may send PHI to a browser-vendor service.
# Keep disabled for the on-premise production profile. Enable only after an
# approved privacy policy and explicit clinician/patient consent workflow.
VITE_ENABLE_BROWSER_ASR_FALLBACK=false

# Required by the production GigaAM CUDA image. CI/deployment must inject the
# exact clean repository commit and a validated clean-tree marker. Prefer
# scripts/build-gigaam-production.ps1, which derives both values and refuses a
# dirty or untracked workspace.
VOICEMED_SOURCE_COMMIT=
VOICEMED_SOURCE_DIRTY=

# On-prem IDs-only radiology classifier used by the production compose profile.
# Promotion requires an image reference ending in @sha256:<64 hex> and the
# SHA-256 of the exact GGUF file; floating/blank identities fail API startup.
LLM_CONTAINER_IMAGE=
LLM_MODEL=deepseek-r1-distill-qwen-14b
LLM_MODEL_PATH=/models/DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf
LLM_MODEL_CHECKSUM=
LLM_PARALLEL_SLOTS=2

# Operational PHI artifact store. Keep the host directory on encrypted storage.
RADIOLOGY_PERSIST_AUDIO=false
RADIOLOGY_STORAGE_RETENTION_DAYS=30
