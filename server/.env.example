PORT=1337
HOST=0.0.0.0
UPLOAD_DIR=./uploads

CORS_ORIGINS=https://localhost:5173,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
HEALTH_CHECK_TIMEOUT_MS=3000

WHISPER_MODEL_PATH=large-v3
WHISPER_LANGUAGE=ru
WHISPER_DEVICE=cuda
WHISPER_PYTHON=
# Canonical radiology sessions require the local GigaAM HTTP runtime.
# Keep it on loopback; never expose the unauthenticated ASR port directly.
WHISPER_SERVER_URL=http://127.0.0.1:9002
WHISPER_REMOTE_ONLY=false
WHISPER_DISABLE_GROQ=false
GROQ_WHISPER_RETRIES=3
GROQ_WHISPER_CHUNK_RETRIES=2
GROQ_WHISPER_MAX_BYTES=20971520
GROQ_WHISPER_SEGMENT_SECONDS=300
GROQ_WHISPER_CHUNK_BITRATE=48k
WHISPER_SERVER_RETRIES=2
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16
WHISPER_BEAM_SIZE=1
# Детектор подозрительных чанков: в chunk_details появляются поля
# `suspicious` (список причин), `fallback_used`, `selected_beam`. Причины:
# low-logprob, АД без X/Y, посев без организма, мусорные единицы,
# phrase-loops. Всегда включён — сигнал пригоден для UX-warning на фронте.
#
# Beam-retry (WHISPER_MAX_FALLBACK_CHUNKS>0): на suspicious чанках повторно
# распознаёт с WHISPER_FALLBACK_BEAM_SIZE, winner — по clinical quality_score.
# Эмпирически не выигрывает у beam=1 на Whisper-артефактах единиц («165 сотых»,
# «гэслчэль», «коэслч»). По-умолчанию выключен (=0).
WHISPER_FALLBACK_BEAM_SIZE=5
WHISPER_SUSPICIOUS_LOGPROB=-0.95
WHISPER_MAX_FALLBACK_CHUNKS=0
WHISPER_DEVICE_INDEX=0
WHISPER_CPU_COMPUTE_TYPE=int8
WHISPER_REMOTE_CHUNK_SECONDS=600
WHISPER_REMOTE_CHUNK_MIN_SECONDS=600
# 32 MiB binary -> ~42.7 MiB base64, safe under a 48 MiB request limit.
# Values above 32 are clamped by the server.
WHISPER_REMOTE_CHUNK_MIN_MB=32
ALLOW_MOCK_TRANSCRIPTION=false

# Server-approved CTC context mapping for the canonical radiology template.
# Enable only when the GigaAM runtime has the same scope in its contexts file
# and GIGAAM_CTC_DECODER=beam. Client-provided hotwords are never forwarded.
# GIGAAM_CT_ABDOMEN_CONTEXT_SCOPE=ct_abdomen_contrast

# Versioned radiology artifacts/feedback stay on-premise under this directory.
# Audio persistence requires BOTH server policy=true and explicit UI consent
# for the individual session. Keep false until retention/consent is approved.
RADIOLOGY_DATA_DIR=./data/radiology
RADIOLOGY_PERSIST_AUDIO=false
# JSON includes base64 overhead; 48 MiB safely carries a <=32 MiB audio blob.
RADIOLOGY_CHUNK_BODY_LIMIT_BYTES=50331648
# In-memory session/audio safeguards. Defaults are deliberately bounded because
# active chunks contain decoded audio bytes until finish/expiry.
# Run the canonical session API as a single worker/replica. Horizontal scaling
# requires sticky routing plus a shared durable active-session store; artifact
# storage alone cannot move an unfinished upload between workers.
RADIOLOGY_SESSION_TTL_MS=1800000
RADIOLOGY_MAX_CHUNK_BYTES=33554432
RADIOLOGY_MAX_CHUNKS_PER_SESSION=64
RADIOLOGY_MAX_SESSION_AUDIO_BYTES=67108864
RADIOLOGY_MAX_ACTIVE_SESSIONS=32
RADIOLOGY_MAX_ACTIVE_AUDIO_BYTES=268435456
RADIOLOGY_MAX_OWNER_ACTIVE_SESSIONS=4
RADIOLOGY_MAX_OWNER_ACTIVE_AUDIO_BYTES=67108864
RADIOLOGY_MAX_PENDING_TRANSCRIPTIONS=8
# Feedback is append-only and requires a client idempotencyKey. Cap revisions
# per artifact and remove expired PHI plus old orphan audio/feedback directories
# opportunistically. Promote reviewed datasets before operational retention ends.
RADIOLOGY_MAX_FEEDBACK_REVISIONS=50
RADIOLOGY_STORAGE_RETENTION_DAYS=30
RADIOLOGY_ORPHAN_GRACE_HOURS=24
RADIOLOGY_STORAGE_CLEANUP_INTERVAL_MS=600000
# Development-only compatibility when the server runs without the doctors DB.
# Unowned PHI cannot be isolated per doctor, so production must keep this false.
RADIOLOGY_ALLOW_UNOWNED_SESSIONS=false
# Old /build, /doc-build and /structure routes are regression-only.
RADIOLOGY_ENABLE_LEGACY_PIPELINES=false

LLM_SERVER_URL=http://localhost:8080
LLM_PROVIDER=llama
LLM_MODEL=qwen3-8b
LLM_MODEL_CHECKSUM=
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.1
LLM_PARALLEL_SLOTS=1
LLM_TIMEOUT_MS=120000
ALLOW_MOCK_LLM=false

# Radiology router is an IDs-only local classifier. It supports `ollama`
# (/api/chat) and `llama` (/v1/chat/completions); cloud providers are rejected.
# Overrides below are optional and otherwise inherit LLM_*.
# RADIOLOGY_LLM_PROVIDER=llama
# RADIOLOGY_LLM_URL=http://localhost:8080
# RADIOLOGY_LLM_MODEL=DeepSeek-R1-Distill-Qwen-14B-Q4_K_M
# RADIOLOGY_LLM_CHECKSUM=sha256:<64 lowercase hex>
# RADIOLOGY_LLM_RUNTIME_IDENTITY=sha256:<runtime hex or image digest>
# RADIOLOGY_LLM_STRICT_IDENTITY=false
# RADIOLOGY_LLM_NUM_CTX=8192
# RADIOLOGY_LLM_NUM_PREDICT=2048
# RADIOLOGY_LLM_TIMEOUT_MS=120000

TTS_SERVER_URL=http://localhost:5500
TTS_ENABLED=true

AUTH_PASSWORD=

# PHI-дамп (raw Whisper + JSON документа) в temp/structure-logs/.
# Содержит медданные пациентов — оставлять отключённым в проде.
STRUCTURE_LOG_DUMP=false

# ВАЖНО: на проде секреты (ANTHROPIC_API_KEY, AUTH_PASSWORD) не хранить в .env.
# Использовать секрет-менеджер (AWS Secrets Manager / Vault / Doppler / 1Password).
# .env только для локальной разработки.
